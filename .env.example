# Production에서는 학교가 승인한 PostgreSQL 연결 문자열로 교체합니다.
DATABASE_URL=postgres://postgres@127.0.0.1:55432/cnu_proofprint

# 학교 SSO가 연결되기 전 로컬 파일럿에서만 true로 사용합니다.
# 공개 배포 환경에서는 반드시 false로 두고 학교 인증을 연결해야 합니다.
PROOFPRINT_DEMO_MODE=true
DEMO_STUDENT_SUB=demo:cnu:202600001

# 애플리케이션 인스턴스당 연결 수입니다. 외부 풀러를 사용할 때는 더 작게 설정합니다.
DB_POOL_MAX=5
PGBOUNCER_TRANSACTION_MODE=false

# CNU 멀티LLM 공식 API/SSO 커넥터가 승인되기 전에는 URL을 비워 데모 모드로 사용합니다.
CNU_MULTI_LLM_CONNECTOR_URL=
CNU_MULTI_LLM_CONNECTOR_TOKEN=

# 학습 에이전트가 쓸 Claude API 키. 없으면 대화는 저장되지만 답변을 만들지 않습니다.
# 학교 멀티LLM 커넥터가 승인되면 그쪽으로 교체합니다.
ANTHROPIC_API_KEY=
